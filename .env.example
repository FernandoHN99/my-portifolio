POSTGRES_DB=my_portifolio
POSTGRES_USER=my_portifolio
POSTGRES_PASSWORD=my_portifolio_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://my_portifolio:my_portifolio_local@127.0.0.1:5432/my_portifolio?schema=public
AWESOME_API_KEY=
COINGECKO_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Opcional: chave gratuita da brapi.dev (B3), reserva do Yahoo Finance.
BRAPI_TOKEN=

# Login (spec 050). Segredo das sessões: gere com `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# E-mails que podem criar conta pela tela, separados por vírgula. Vazio: ninguém.
AUTH_ALLOWED_EMAILS=
# Hosts extras aceitos pelo login, além dos da Vercel e do localhost.
AUTH_ALLOWED_HOSTS=
# Usuário local dos testes de interface (pnpm auth:user create cria a conta).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
