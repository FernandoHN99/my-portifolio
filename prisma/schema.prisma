// Os primeiros modelos preservam a origem da importação. Entidades
// financeiras normalizadas serão adicionadas somente depois da revisão.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
}

enum ImportIssueSeverity {
  INFO
  WARNING
  ERROR
}

model ImportBatch {
  id          String            @id @default(uuid()) @db.Uuid
  sourcePath  String            @map("source_path")
  sourceHash  String            @map("source_hash")
  status      ImportStatus      @default(PENDING)
  rowsRead    Int               @default(0) @map("rows_read")
  startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(3)
  sourceRows  ImportSourceRow[]
  issues      ImportIssue[]
  months      PortfolioMonth[]
  targetPlans TargetPlan[]

  @@unique([sourceHash])
  @@map("import_batches")
}

model ImportSourceRow {
  id                 BigInt              @id @default(autoincrement())
  batchId            String              @map("batch_id") @db.Uuid
  sourceSheet        String              @map("source_sheet")
  sourceTable        String              @map("source_table")
  sourceRow          Int                 @map("source_row")
  content            Json
  batch              ImportBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position           Position?
  marketQuote        MarketQuote?
  positionAllocation PositionAllocation?

  @@unique([batchId, sourceTable, sourceRow])
  @@index([sourceSheet, sourceTable])
  @@map("import_source_rows")
}

model ImportIssue {
  id          BigInt              @id @default(autoincrement())
  batchId     String              @map("batch_id") @db.Uuid
  severity    ImportIssueSeverity
  code        String
  message     String
  sourceSheet String?             @map("source_sheet")
  sourceTable String?             @map("source_table")
  sourceRow   Int?                @map("source_row")
  sourceField String?             @map("source_field")
  rawValue    Json?               @map("raw_value")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  batch       ImportBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, severity])
  @@map("import_issues")
}

enum PortfolioMonthStatus {
  IMPORTED
  DRAFT
  REVIEWED
}

model Institution {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique @map("normalized_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  accounts       Account[]

  @@map("institutions")
}

model Account {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  name          String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  positions     Position[]

  @@unique([institutionId, name])
  @@map("accounts")
}

model Asset {
  id            String     @id @default(uuid()) @db.Uuid
  normalizedKey String     @unique @map("normalized_key")
  name          String
  ticker        String?
  quoteSymbol   String?    @map("quote_symbol")
  baseCurrency  String     @map("base_currency")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  positions     Position[]

  @@index([ticker])
  @@map("assets")
}

model PortfolioMonth {
  id             String               @id @default(uuid()) @db.Uuid
  sourceBatchId  String?              @map("source_batch_id") @db.Uuid
  referenceDate  DateTime             @unique @map("reference_date") @db.Date
  status         PortfolioMonthStatus @default(IMPORTED)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  sourceBatch    ImportBatch?         @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)
  positions      Position[]
  sourceUpdates  MonthlyUpdateRun[]   @relation("MonthlyUpdateSource")
  targetUpdate   MonthlyUpdateRun?    @relation("MonthlyUpdateTarget")
  quoteRefreshes QuoteRefreshRun[]

  @@map("portfolio_months")
}

model Position {
  id               String               @id @default(uuid()) @db.Uuid
  portfolioMonthId String               @map("portfolio_month_id") @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  assetId          String               @map("asset_id") @db.Uuid
  sourceRowId      BigInt?              @unique @map("source_row_id")
  quantity         Decimal              @db.Decimal(30, 12)
  unitPriceBrl     Decimal?             @map("unit_price_brl") @db.Decimal(24, 8)
  exchangeRateBrl  Decimal?             @map("exchange_rate_brl") @db.Decimal(20, 8)
  totalBrl         Decimal              @map("total_brl") @db.Decimal(24, 2)
  strategy         String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  portfolioMonth   PortfolioMonth       @relation(fields: [portfolioMonthId], references: [id], onDelete: Cascade)
  account          Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  asset            Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sourceRow        ImportSourceRow?     @relation(fields: [sourceRowId], references: [id], onDelete: SetNull)
  allocations      PositionAllocation[]

  @@unique([portfolioMonthId, accountId, assetId])
  @@index([portfolioMonthId])
  @@index([accountId])
  @@index([assetId])
  @@map("positions")
}

model MarketQuote {
  id             String           @id @default(uuid()) @db.Uuid
  sourceRowId    BigInt?          @unique @map("source_row_id")
  referenceDate  DateTime         @map("reference_date") @db.Date
  symbol         String
  instrumentType String           @map("instrument_type")
  baseCurrency   String           @map("base_currency")
  valueBrl       Decimal          @map("value_brl") @db.Decimal(24, 8)
  // Dia do preço que a cotação do mês carrega, quando conhecido. Nulo nas
  // cotações importadas do Excel e nas editadas à mão, que são fatos mensais.
  quoteDate      DateTime?        @map("quote_date") @db.Date
  // Competência cuja cotação foi repetida, quando o mês não tem valor próprio:
  // virada de mês sem histórico diário no mês ou clone do mês anterior. Nulo
  // quando o valor é do próprio mês: importado, atualizado ou editado à mão.
  carriedFrom    DateTime?        @map("carried_from") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  sourceRow      ImportSourceRow? @relation(fields: [sourceRowId], references: [id], onDelete: SetNull)

  @@unique([referenceDate, symbol])
  @@index([symbol])
  @@map("market_quotes")
}

enum QuoteRefreshTrigger {
  AUTO
  MANUAL
}

enum QuoteRefreshStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
}

// Histórico diário: uma cotação por símbolo e dia. Cada atualização do dia
// sobrescreve o valor daquele dia, nunca o de outro.
model DailyQuote {
  id             String           @id @default(uuid()) @db.Uuid
  symbol         String
  quoteDate      DateTime         @map("quote_date") @db.Date
  instrumentType String           @map("instrument_type")
  baseCurrency   String           @map("base_currency")
  valueBrl       Decimal          @map("value_brl") @db.Decimal(24, 8)
  provider       String
  fetchedAt      DateTime         @map("fetched_at") @db.Timestamptz(3)
  runId          String?          @map("run_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  run            QuoteRefreshRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([symbol, quoteDate])
  @@index([quoteDate])
  @@map("daily_quotes")
}

model QuoteRefreshRun {
  id               String               @id @default(uuid()) @db.Uuid
  trigger          QuoteRefreshTrigger
  status           QuoteRefreshStatus   @default(RUNNING)
  quoteDate        DateTime             @map("quote_date") @db.Date
  portfolioMonthId String?              @map("portfolio_month_id") @db.Uuid
  startedAt        DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?            @map("finished_at") @db.Timestamptz(3)
  errorMessage     String?              @map("error_message")
  portfolioMonth   PortfolioMonth?      @relation(fields: [portfolioMonthId], references: [id], onDelete: SetNull)
  results          QuoteRefreshResult[]
  dailyQuotes      DailyQuote[]

  @@index([startedAt])
  @@index([status])
  @@map("quote_refresh_runs")
}

model QuoteRefreshResult {
  id           BigInt            @id @default(autoincrement())
  runId        String            @map("run_id") @db.Uuid
  symbol       String
  provider     String
  status       QuoteUpdateStatus
  valueBrl     Decimal?          @map("value_brl") @db.Decimal(24, 8)
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  fetchedAt    DateTime          @default(now()) @map("fetched_at") @db.Timestamptz(3)
  run          QuoteRefreshRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, symbol])
  @@index([runId, status])
  @@map("quote_refresh_results")
}

enum MonthlyUpdateStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
}

enum QuoteUpdateStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model MonthlyUpdateRun {
  id            String              @id @default(uuid()) @db.Uuid
  sourceMonthId String              @map("source_month_id") @db.Uuid
  targetMonthId String              @unique @map("target_month_id") @db.Uuid
  status        MonthlyUpdateStatus @default(RUNNING)
  startedAt     DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(3)
  errorMessage  String?             @map("error_message")
  sourceMonth   PortfolioMonth      @relation("MonthlyUpdateSource", fields: [sourceMonthId], references: [id], onDelete: Restrict)
  targetMonth   PortfolioMonth      @relation("MonthlyUpdateTarget", fields: [targetMonthId], references: [id], onDelete: Cascade)
  quoteResults  QuoteUpdateResult[]

  @@index([status])
  @@map("monthly_update_runs")
}

model QuoteUpdateResult {
  id           BigInt            @id @default(autoincrement())
  runId        String            @map("run_id") @db.Uuid
  symbol       String
  provider     String
  status       QuoteUpdateStatus
  valueBrl     Decimal?          @map("value_brl") @db.Decimal(24, 8)
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  fetchedAt    DateTime          @default(now()) @map("fetched_at") @db.Timestamptz(3)
  run          MonthlyUpdateRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, symbol])
  @@index([runId, status])
  @@map("quote_update_results")
}

model PositionAllocation {
  id          String           @id @default(uuid()) @db.Uuid
  positionId  String           @map("position_id") @db.Uuid
  sourceRowId BigInt?          @unique @map("source_row_id")
  assetClass  String           @map("asset_class")
  subclass    String
  duration    String
  weight      Decimal          @db.Decimal(12, 10)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  position    Position         @relation(fields: [positionId], references: [id], onDelete: Cascade)
  sourceRow   ImportSourceRow? @relation(fields: [sourceRowId], references: [id], onDelete: SetNull)

  @@unique([positionId, assetClass, subclass, duration])
  @@index([positionId])
  @@map("position_allocations")
}

enum AllocationTargetScope {
  ASSET_CLASS
  CURRENCY
  STRATEGY
  CLASS_CURRENCY
  FIXED_INCOME
  VARIABLE_INCOME
}

model TargetPlan {
  id               String             @id @default(uuid()) @db.Uuid
  sourceBatchId    String?            @unique @map("source_batch_id") @db.Uuid
  name             String
  isActive         Boolean            @default(true) @map("is_active")
  tolerancePercent Decimal            @default(2) @map("tolerance_percent") @db.Decimal(5, 2)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sourceBatch      ImportBatch?       @relation(fields: [sourceBatchId], references: [id], onDelete: Cascade)
  targets          AllocationTarget[]

  @@map("target_plans")
}

model AllocationTarget {
  id             String                @id @default(uuid()) @db.Uuid
  planId         String                @map("plan_id") @db.Uuid
  key            String
  scope          AllocationTargetScope
  primaryLabel   String                @map("primary_label")
  secondaryLabel String?               @map("secondary_label")
  percentage     Decimal               @db.Decimal(12, 10)
  sourceSheet    String?               @map("source_sheet")
  sourceCell     String?               @map("source_cell")
  plan           TargetPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId, scope])
  @@map("allocation_targets")
}
