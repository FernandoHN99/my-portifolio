// Os dados entram e saem do aplicativo pelo backup em JSON (spec 042); o
// formato acompanha este schema e é mantido conforme docs/backup-format.md.
//
// Dados por usuário (spec 050): as tabelas da carteira têm `user_id`, e as
// chaves estrangeiras entre elas incluem o usuário, para nenhuma linha apontar
// para dados de outro. O código as acessa pelo cliente com escopo
// (src/lib/user-db.ts). As cotações são compartilhadas (spec 051).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Login (spec 050): tabelas do Better Auth, com os nomes de campo que a
// biblioteca usa. `auth_accounts` guarda a senha; `accounts` é das contas da
// carteira. Os ids são UUID, como os das tabelas da carteira que apontam para o
// usuário.
model User {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  authAccounts  AuthAccount[]
  dataImports   DataImport[]
  institutions  Institution[]
  assets        Asset[]
  months        PortfolioMonth[]
  targetPlans   TargetPlan[]
  manualQuotes  ManualQuote[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Contagem do limite de pedidos do login, no banco porque na Vercel cada
// instância tem a própria memória.
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

/// Importação de um backup (spec 047): a configuração mostra cada uma ao lado
/// das versões das metas.
model DataImport {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  importedAt    DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  /// Quando o arquivo importado foi exportado.
  exportedAt    DateTime @map("exported_at") @db.Timestamptz(3)
  formatVersion Int      @map("format_version")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, importedAt])
  @@map("data_imports")
}

// Mês aberto (DRAFT), que aceita edição, ou fechado (REVIEWED) (spec 034).
enum PortfolioMonthStatus {
  DRAFT
  REVIEWED
}

model Institution {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  normalizedName String    @map("normalized_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts       Account[]

  @@unique([userId, normalizedName])
  @@unique([id, userId])
  @@map("institutions")
}

model Account {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  name          String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  // NoAction: como Restrict, mas conferido no fim do comando, o que deixa a
  // exclusão de um usuário apagar tudo dele de uma vez.
  institution   Institution @relation(fields: [institutionId, userId], references: [id, userId], onDelete: NoAction)
  positions     Position[]

  @@unique([institutionId, name])
  @@unique([id, userId])
  @@index([userId])
  @@map("accounts")
}

model Asset {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  normalizedKey   String     @map("normalized_key")
  name            String
  ticker          String?
  quoteSymbol     String?    @map("quote_symbol")
  baseCurrency    String     @map("base_currency")
  // Vencimento informativo de ativos sem ticker, como renda fixa (spec 026).
  // Só ativos criados pela interface o recebem; os importados ficam nulos.
  maturityDate    DateTime?  @map("maturity_date") @db.Date
  // Prazo de liquidez do ativo, opcional (spec 039): em quanto tempo o dinheiro
  // fica disponível no resgate, como "D+0", "D+1" ou "No vencimento". Diferente
  // do vencimento e do resgate Curto, Médio e Longo do rateio.
  liquidity       String?
  // Identificador do símbolo no provedor quando não é o próprio símbolo: a
  // moeda da CoinGecko conferida ao incluir um cripto novo (spec 026), para a
  // atualização de cotações não buscar outra moeda com o mesmo símbolo. Nulo
  // nos demais ativos; BTC e SOL têm identificador fixo no código.
  quoteProviderId String?    @map("quote_provider_id")
  // Conta corrente (spec 059): um caixa em reais ou em dólar marcado para
  // receber o dinheiro de títulos vencidos e de outras liquidações.
  cashAccount     Boolean    @default(false) @map("cash_account")
  // Percentual do CDI da spec 060, legado: desde a spec 079 a rentabilidade é
  // de cada classificação (`position_allocations.rate_percent`). O dia da
  // aplicação é aquele a partir do qual o rendimento bruto é calculado.
  cdiPercent      Decimal?   @map("cdi_percent") @db.Decimal(7, 3)
  appliedOn       DateTime?  @map("applied_on") @db.Date
  // Rendimento calculado automaticamente (spec 079), como os bancos: pela
  // rentabilidade de cada classificação, em dias úteis.
  autoIncome      Boolean    @default(false) @map("auto_income")
  // Tipo do ativo (spec 068), para a visão por tipo, como Tesouro Direto ou
  // ETF dos EUA. Uma das chaves de `ASSET_TYPES`; nulo nos ativos antigos, cujo
  // tipo é inferido na leitura até o usuário escolher um.
  assetType       String?    @map("asset_type")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions       Position[]

  @@unique([userId, normalizedKey])
  @@unique([id, userId])
  @@index([ticker])
  @@map("assets")
}

model PortfolioMonth {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  referenceDate  DateTime             @map("reference_date") @db.Date
  status         PortfolioMonthStatus @default(REVIEWED)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions      Position[]

  @@unique([userId, referenceDate])
  @@unique([id, userId])
  @@index([referenceDate])
  @@map("portfolio_months")
}

model Position {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  portfolioMonthId String               @map("portfolio_month_id") @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  assetId          String               @map("asset_id") @db.Uuid
  quantity         Decimal              @db.Decimal(30, 12)
  /// Base do mês (spec 056): a quantidade com que a posição abriu a competência,
  /// herdada uma vez do fechamento do mês anterior. A quantidade é a base mais
  /// as movimentações do mês. Zero numa posição incluída no mês.
  openingQuantity  Decimal              @default(0) @map("opening_quantity") @db.Decimal(30, 12)
  /// Data financeira da base do mês; nula no legado até configuração explícita.
  calculationStartDate DateTime?        @map("calculation_start_date") @db.Date
  /// Retorno automático do próprio mês, separado das movimentações (spec 060).
  calculatedIncomeBrl Decimal           @default(0) @map("calculated_income_brl") @db.Decimal(24, 8)
  incomeCalculatedThrough DateTime?     @map("income_calculated_through") @db.Date
  incomeCalculationError String?        @map("income_calculation_error")
  unitPriceBrl     Decimal?             @map("unit_price_brl") @db.Decimal(24, 8)
  exchangeRateBrl  Decimal?             @map("exchange_rate_brl") @db.Decimal(20, 8)
  totalBrl         Decimal              @map("total_brl") @db.Decimal(24, 2)
  strategy         String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  portfolioMonth   PortfolioMonth       @relation(fields: [portfolioMonthId, userId], references: [id, userId], onDelete: Cascade)
  account          Account              @relation(fields: [accountId, userId], references: [id, userId], onDelete: NoAction)
  asset            Asset                @relation(fields: [assetId, userId], references: [id, userId], onDelete: NoAction)
  allocations      PositionAllocation[]
  transactions     PositionTransaction[]

  @@unique([portfolioMonthId, accountId, assetId])
  @@unique([id, userId])
  @@index([portfolioMonthId])
  @@index([accountId])
  @@index([assetId])
  @@map("positions")
}

// Cotação de cada mês, compartilhada entre os usuários (spec 051): vem dos
// provedores, da virada de mês ou da inclusão de um ativo. A cotação digitada
// por um usuário fica em ManualQuote e vale só para ele.
enum PositionTransactionKind {
  CONTRIBUTION
  WITHDRAWAL
  INCOME
  OPENING
}

// Movimentação de uma posição (spec 056): saldo inicial de uma posição nova,
// aporte, retirada ou rendimento. Fica na posição da competência em que foi
// registrada; a quantidade da posição é a base do mês mais as movimentações
// dele. Só as do mês aberto podem ser incluídas, corrigidas ou apagadas, e a
// correção não mexe em outros meses.
model PositionTransaction {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @map("user_id") @db.Uuid
  positionId   String                  @map("position_id") @db.Uuid
  kind         PositionTransactionKind
  occurredOn   DateTime                @map("occurred_on") @db.Date
  /// Quantidade movimentada: unidades nos ativos cotados, dólares no caixa em
  /// dólar e o próprio valor nos saldos em reais. Sempre positiva; zero no
  /// rendimento recebido em dinheiro, como dividendos.
  quantity     Decimal                 @db.Decimal(30, 12)
  /// Preço executado em reais (o de compra ou de venda, ou o câmbio no caixa em
  /// dólar), diferente da cotação do mês. Nulo nos saldos em reais.
  unitPriceBrl Decimal?                @map("unit_price_brl") @db.Decimal(24, 8)
  /// Dinheiro movimentado em reais. Positivo; só o rendimento de acerto de
  /// uma liquidação pode ser negativo (spec 059).
  amountBrl    Decimal                 @map("amount_brl") @db.Decimal(24, 2)
  note         String?
  /// Liga as pernas de uma transferência interna, como a liquidação de um
  /// título num caixa (spec 059): não é aporte externo nem rendimento novo.
  transferId   String?                 @map("transfer_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  position     Position                @relation(fields: [positionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([positionId, occurredOn])
  @@index([userId])
  @@index([transferId])
  @@map("position_transactions")
}

// Indexadores diários compartilhados (spec 060): percentual ao dia, nunca preço
// em reais. O CDI observado na SGS12 é diferente da Selic e da cotação de ativo.
model RateObservation {
  id           String   @id @default(uuid()) @db.Uuid
  indexer      String
  date         DateTime @db.Date
  dailyPercent Decimal  @map("daily_percent") @db.Decimal(18, 12)
  source       String
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(3)

  @@unique([indexer, date])
  @@index([date])
  @@map("rate_observations")
}

// Janelas lidas integralmente da fonte. Uma ausência dentro da resposta não
// inventa uma taxa: só as observações efetivamente publicadas acumulam juros.
model RateCoverage {
  id                String   @id @default(uuid()) @db.Uuid
  indexer           String
  fromDate          DateTime @map("from_date") @db.Date
  throughDate       DateTime @map("through_date") @db.Date
  lastPublishedDate DateTime? @map("last_published_date") @db.Date
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(3)

  @@unique([indexer, fromDate, throughDate])
  @@map("rate_coverage")
}

// Taxas de referência informativas, compartilhadas (spec 064). A meta Selic
// é percentual ao ano, nunca cotação em reais nem CDI diário.
model ReferenceRate {
  key           String    @id
  percentAnnual Decimal?  @map("percent_annual") @db.Decimal(12, 6)
  observedOn    DateTime? @map("observed_on") @db.Date
  source        String?
  fetchedAt     DateTime? @map("fetched_at") @db.Timestamptz(3)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  errorMessage  String?   @map("error_message")

  @@map("reference_rates")
}

// Histórico da meta Selic (spec 067): um ponto a cada mudança da taxa, para
// mostrar a meta vigente em cada competência. Compartilhado e recarregável
// pelo job, fora do backup como `reference_rates`.
model ReferenceRatePoint {
  key           String
  effectiveOn   DateTime @map("effective_on") @db.Date
  percentAnnual Decimal  @map("percent_annual") @db.Decimal(12, 6)

  @@id([key, effectiveOn])
  @@map("reference_rate_points")
}

model MarketQuote {
  id             String    @id @default(uuid()) @db.Uuid
  referenceDate  DateTime  @map("reference_date") @db.Date
  symbol         String
  instrumentType String    @map("instrument_type")
  baseCurrency   String    @map("base_currency")
  valueBrl       Decimal   @map("value_brl") @db.Decimal(24, 8)
  // Dia do preço que a cotação do mês carrega, quando conhecido. Nulo nas
  // cotações importadas do Excel, que são fatos mensais.
  quoteDate      DateTime? @map("quote_date") @db.Date
  // Competência cuja cotação foi repetida, quando o mês não tem valor próprio:
  // virada de mês sem histórico diário no mês ou clone do mês anterior. Nulo
  // quando o valor é do próprio mês: importado ou atualizado.
  carriedFrom    DateTime? @map("carried_from") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([referenceDate, symbol])
  @@index([symbol])
  @@map("market_quotes")
}

// Cotação digitada por um usuário (spec 051), só para cotação não encontrada ou
// com falha na última busca (spec 028). Vale por cima da compartilhada, só para
// ele, até a próxima atualização bem-sucedida do símbolo no mês corrente.
model ManualQuote {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  referenceDate  DateTime @map("reference_date") @db.Date
  symbol         String
  instrumentType String   @map("instrument_type")
  baseCurrency   String   @map("base_currency")
  valueBrl       Decimal  @map("value_brl") @db.Decimal(24, 8)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceDate, symbol])
  @@index([referenceDate, symbol])
  @@map("manual_quotes")
}

enum QuoteRefreshStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
}

// Histórico diário: uma cotação por símbolo e dia. Cada atualização do dia
// sobrescreve o valor daquele dia, nunca o de outro.
model DailyQuote {
  id             String           @id @default(uuid()) @db.Uuid
  symbol         String
  quoteDate      DateTime         @map("quote_date") @db.Date
  instrumentType String           @map("instrument_type")
  baseCurrency   String           @map("base_currency")
  valueBrl       Decimal          @map("value_brl") @db.Decimal(24, 8)
  provider       String
  fetchedAt      DateTime         @map("fetched_at") @db.Timestamptz(3)
  runId          String?          @map("run_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  run            QuoteRefreshRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([symbol, quoteDate])
  @@index([quoteDate])
  @@map("daily_quotes")
}

// Execução da atualização automática de cotações, de todos os usuários
// (spec 051). Cada um vê só os resultados dos próprios símbolos.
enum QuoteSymbolStatus {
  PENDING
  ACTIVE
  ERROR
}

// Cadastro dos símbolos cotados, compartilhado por todos os usuários (spec
// 053). O símbolo é a mesma chave de daily_quotes, market_quotes e
// manual_quotes. O job agendado lê daqui o que buscar e grava aqui o resultado
// de cada tentativa; quem usa o símbolo são os ativos dos usuários.
model QuoteSymbol {
  symbol             String            @id
  instrumentType     String            @map("instrument_type")
  baseCurrency       String            @map("base_currency")
  /// Moeda da CoinGecko do símbolo, a mesma para todos os usuários.
  providerId         String?           @map("provider_id")
  status             QuoteSymbolStatus @default(PENDING)
  lastAttemptAt      DateTime?         @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt      DateTime?         @map("last_success_at") @db.Timestamptz(3)
  /// Falhas seguidas da cotação atual; volta a zero no sucesso.
  failureCount       Int               @default(0) @map("failure_count")
  lastErrorCode      String?           @map("last_error_code")
  lastErrorMessage   String?           @map("last_error_message")
  /// Espera depois de falhas: antes disso o job não tenta de novo.
  nextAttemptAt      DateTime?         @map("next_attempt_at") @db.Timestamptz(3)
  /// Último mês (dia 1) com o histórico de fechamento conferido; nulo até o
  /// primeiro carregamento.
  historySyncedUntil DateTime?         @map("history_synced_until") @db.Date
  historyAttemptedAt DateTime?         @map("history_attempted_at") @db.Timestamptz(3)
  historyError       String?           @map("history_error")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("quote_symbols")
}

model QuoteRefreshRun {
  id            String               @id @default(uuid()) @db.Uuid
  status        QuoteRefreshStatus   @default(RUNNING)
  quoteDate     DateTime             @map("quote_date") @db.Date
  /// Competência reprecificada (o mês corrente), quando algum usuário a tinha.
  repricedMonth DateTime?            @map("repriced_month") @db.Date
  startedAt     DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?            @map("finished_at") @db.Timestamptz(3)
  errorMessage  String?              @map("error_message")
  results       QuoteRefreshResult[]
  dailyQuotes      DailyQuote[]

  @@index([startedAt])
  @@index([status])
  @@map("quote_refresh_runs")
}

model QuoteRefreshResult {
  id           BigInt            @id @default(autoincrement())
  runId        String            @map("run_id") @db.Uuid
  symbol       String
  provider     String
  status       QuoteUpdateStatus
  valueBrl     Decimal?          @map("value_brl") @db.Decimal(24, 8)
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  fetchedAt    DateTime          @default(now()) @map("fetched_at") @db.Timestamptz(3)
  run          QuoteRefreshRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, symbol])
  @@index([runId, status])
  @@map("quote_refresh_results")
}

enum QuoteUpdateStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model PositionAllocation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  positionId String   @map("position_id") @db.Uuid
  assetClass String   @map("asset_class")
  subclass   String
  duration   String
  weight     Decimal  @db.Decimal(12, 10)
  // Rentabilidade da classificação (spec 079), pelo indexador da subclasse:
  // % do CDI no pós-fixado (105 = 105% do CDI) e taxa ao ano no prefixado
  // (12.5 = 12,5% a.a.). Opcional; exigida com o rendimento automático.
  ratePercent Decimal? @map("rate_percent") @db.Decimal(9, 4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  position   Position @relation(fields: [positionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([positionId, assetClass, subclass, duration])
  @@index([positionId])
  @@map("position_allocations")
}

enum AllocationTargetScope {
  ASSET_CLASS
  CURRENCY
  STRATEGY
  CLASS_CURRENCY
  FIXED_INCOME
  VARIABLE_INCOME
}

model TargetPlan {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  name             String
  isActive         Boolean            @default(true) @map("is_active")
  tolerancePercent Decimal            @default(2) @map("tolerance_percent") @db.Decimal(5, 2)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets          AllocationTarget[]

  @@unique([id, userId])
  @@index([userId])
  @@map("target_plans")
}

model AllocationTarget {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  planId         String                @map("plan_id") @db.Uuid
  key            String
  scope          AllocationTargetScope
  primaryLabel   String                @map("primary_label")
  secondaryLabel String?               @map("secondary_label")
  percentage     Decimal               @db.Decimal(12, 10)
  plan           TargetPlan            @relation(fields: [planId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId, scope])
  @@map("allocation_targets")
}
